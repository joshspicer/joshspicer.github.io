---
import SocialIcon from './SocialIcon.astro';

interface Props {
  iconOnly?: boolean;
}

const { iconOnly = false } = Astro.props;
---

<a
  class:list={iconOnly ? ['icon-link'] : ['email-link']}
  href="/contact/#email"
  data-obfuscated-email
  aria-label={iconOnly ? 'Email' : 'Email me'}
  title={iconOnly ? 'Email' : undefined}
>
  <SocialIcon name="email" />
  {!iconOnly && <span>Email me</span>}
</a>

<script is:inline>
  (() => {
    const address = [
      104, 101, 108, 108, 111, 64, 106, 111, 115, 104, 115, 112, 105, 99, 101,
      114, 46, 99, 111, 109,
    ].map((code) => String.fromCharCode(code)).join('');

    for (const link of document.querySelectorAll('[data-obfuscated-email]')) {
      link.setAttribute('href', `mailto:${address}`);
    }
  })();
</script>
