---
import { siteConfig } from '../site.config';
import { withBase } from '../utils/paths';
import EmailLink from './EmailLink.astro';
import SocialIcon from './SocialIcon.astro';
---

<footer class="site-footer">
  <div class="footer-meta">
    <span>&copy; {new Date().getFullYear()} {siteConfig.name}</span>
    <div class="footer-settings" data-settings hidden>
      <button
        type="button"
        class="icon-link settings-toggle"
        data-settings-toggle
        aria-label="Open site settings"
        title="Site settings"
        aria-expanded="false"
        aria-controls="site-settings-menu"
      >
        <svg class="settings-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h10M18 7h2M4 17h2M10 17h10" />
          <circle cx="16" cy="7" r="2" />
          <circle cx="8" cy="17" r="2" />
        </svg>
      </button>
      <div
        class="settings-menu"
        id="site-settings-menu"
        data-settings-menu
        role="dialog"
        aria-label="Site settings"
        hidden
      >
        <div class="settings-group" role="group" aria-labelledby="animation-label">
          <span class="settings-label" id="animation-label">Animation</span>
          <div class="settings-options animation-options">
            <button type="button" data-animation-option="a">A <small>Shuffle</small></button>
            <button type="button" data-animation-option="b">B <small>Jackpot</small></button>
            <button type="button" data-animation-option="c">C <small>Reel</small></button>
            <button type="button" data-animation-option="d">D <small>Wipe</small></button>
          </div>
        </div>
        <div class="settings-group" role="group" aria-labelledby="theme-label">
          <span class="settings-label" id="theme-label">Theme</span>
          <div class="settings-options theme-options">
            <button type="button" data-theme-option="system">System</button>
            <button type="button" data-theme-option="light">Light</button>
            <button type="button" data-theme-option="dark">Dark</button>
          </div>
        </div>
        <button type="button" class="settings-row settings-reset" data-clear-site-storage>
          <span>Clear saved settings</span>
          <span class="settings-value">Reset</span>
        </button>
      </div>
    </div>
  </div>
  <nav class="footer-links" aria-label="Footer links">
    {siteConfig.links.map((link) => (
      <a
        class="icon-link"
        href={link.href}
        rel="me"
        aria-label={link.label}
        title={link.label}
      >
        <SocialIcon name={link.icon} />
      </a>
    ))}
    <a
      class="icon-link"
      href={withBase('/rss.xml')}
      aria-label="RSS feed"
      title="RSS feed"
    >
      <SocialIcon name="rss" />
    </a>
    <EmailLink iconOnly />
  </nav>
</footer>

<script>
  import { HIGHLIGHT_ANIMATION_STORAGE_KEY } from '../scripts/highlightAnimations';

  const settings = document.querySelector('[data-settings]');
  const settingsButton = document.querySelector('[data-settings-toggle]');
  const settingsMenu = document.querySelector('[data-settings-menu]');
  const clearStorageButton = document.querySelector('[data-clear-site-storage]');
  const animationButtons = document.querySelectorAll('[data-animation-option]');
  const themeButtons = document.querySelectorAll('[data-theme-option]');
  const themeColor = document.querySelector('meta[name="theme-color"]');
  const darkMode = window.matchMedia('(prefers-color-scheme: dark)');

  const getActiveTheme = () =>
    document.documentElement.dataset.theme ??
    (darkMode.matches ? 'dark' : 'light');

  const updateThemeControls = () => {
    const activeTheme = getActiveTheme();
    const themeSetting = document.documentElement.dataset.theme ?? 'system';
    for (const button of themeButtons) {
      if (!(button instanceof HTMLButtonElement)) continue;
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.themeOption === themeSetting),
      );
    }

    if (themeColor instanceof HTMLMetaElement) {
      themeColor.content = activeTheme === 'dark' ? '#383934' : '#f6f3eb';
    }
  };

  for (const button of themeButtons) {
    if (!(button instanceof HTMLButtonElement)) continue;
    button.addEventListener('click', () => {
      const theme = button.dataset.themeOption;
      if (theme === 'light' || theme === 'dark') {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('site-theme', theme);
      } else if (theme === 'system') {
        delete document.documentElement.dataset.theme;
        localStorage.removeItem('site-theme');
      }
      updateThemeControls();
    });
  }

  const closeSettings = () => {
    if (
      !(settingsButton instanceof HTMLButtonElement) ||
      !(settingsMenu instanceof HTMLElement)
    ) {
      return;
    }

    settingsButton.ariaExpanded = 'false';
    settingsButton.ariaLabel = 'Open site settings';
    settingsMenu.hidden = true;
  };

  settingsButton?.addEventListener('click', () => {
    if (
      !(settingsButton instanceof HTMLButtonElement) ||
      !(settingsMenu instanceof HTMLElement)
    ) {
      return;
    }

    const willOpen = settingsMenu.hidden;
    settingsMenu.hidden = !willOpen;
    settingsButton.ariaExpanded = String(willOpen);
    settingsButton.ariaLabel = willOpen
      ? 'Close site settings'
      : 'Open site settings';
  });

  document.addEventListener('click', (event) => {
    if (
      settings instanceof HTMLElement &&
      event.target instanceof Node &&
      !settings.contains(event.target)
    ) {
      closeSettings();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !(settingsMenu instanceof HTMLElement)) return;
    if (settingsMenu.hidden) return;

    closeSettings();
    if (settingsButton instanceof HTMLButtonElement) settingsButton.focus();
  });

  for (const button of animationButtons) {
    if (!(button instanceof HTMLButtonElement)) continue;
    const selected =
      button.dataset.animationOption ===
      document.documentElement.dataset.highlightAnimation;
    button.setAttribute('aria-pressed', String(selected));
    button.addEventListener('click', () => {
      const animation = button.dataset.animationOption;
      if (!animation) return;

      localStorage.setItem(HIGHLIGHT_ANIMATION_STORAGE_KEY, animation);
      const url = new URL(window.location.href);
      url.searchParams.set('animation', animation);
      window.location.assign(url);
    });
  }

  clearStorageButton?.addEventListener('click', () => {
    localStorage.clear();
    sessionStorage.clear();
    const url = new URL(window.location.href);
    url.searchParams.delete('animation');
    window.location.replace(url);
  });

  darkMode.addEventListener('change', () => {
    if (!document.documentElement.dataset.theme) updateThemeControls();
  });

  if (settings instanceof HTMLElement) settings.hidden = false;
  updateThemeControls();
</script>
<style>
  @media (max-width: 34rem) {
    .site-footer {
      padding-bottom: max(2.5rem, calc(env(safe-area-inset-bottom) + 1.5rem));
    }

    .footer-links {
      order: -1;
    }
  }
</style>
