---
import { siteConfig } from '../site.config';
import { withBase } from '../utils/paths';
import EmailLink from './EmailLink.astro';
import SocialIcon from './SocialIcon.astro';
---

<footer class="site-footer">
  <div class="footer-meta">
    <span>&copy; {new Date().getFullYear()} {siteConfig.name}</span>
    <button
      type="button"
      class="icon-link theme-toggle"
      data-theme-toggle
      aria-label="Switch theme"
      title="Switch theme"
      hidden
    >
      <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path
          class="theme-icon-sun"
          d="M12 3V1.75M12 22.25V21M3 12H1.75M22.25 12H21M5.64 5.64 4.75 4.75M19.25 19.25l-.89-.89M18.36 5.64l.89-.89M4.75 19.25l.89-.89M16.25 12A4.25 4.25 0 1 1 7.75 12a4.25 4.25 0 0 1 8.5 0Z"
        />
        <path
          class="theme-icon-moon"
          d="M20 15.4A8.5 8.5 0 0 1 8.6 4a8.5 8.5 0 1 0 11.4 11.4Z"
        />
      </svg>
    </button>
  </div>
  <nav class="footer-links" aria-label="Footer links">
    {siteConfig.links.map((link) => (
      <a
        class="icon-link"
        href={link.href}
        rel="me"
        aria-label={link.label}
        title={link.label}
      >
        <SocialIcon name={link.icon} />
      </a>
    ))}
    <a
      class="icon-link"
      href={withBase('/rss.xml')}
      aria-label="RSS feed"
      title="RSS feed"
    >
      <SocialIcon name="rss" />
    </a>
    <EmailLink iconOnly />
  </nav>
</footer>

<script>
  const themeButton = document.querySelector('[data-theme-toggle]');
  const themeColor = document.querySelector('meta[name="theme-color"]');
  const darkMode = window.matchMedia('(prefers-color-scheme: dark)');

  const getActiveTheme = () =>
    document.documentElement.dataset.theme ??
    (darkMode.matches ? 'dark' : 'light');

  const updateThemeControl = () => {
    if (!(themeButton instanceof HTMLButtonElement)) return;

    const activeTheme = getActiveTheme();
    const targetTheme = activeTheme === 'dark' ? 'light' : 'dark';
    const label = `Switch to ${targetTheme} theme`;

    themeButton.dataset.activeTheme = activeTheme;
    themeButton.ariaLabel = label;
    themeButton.title = label;
    themeButton.hidden = false;

    if (themeColor instanceof HTMLMetaElement) {
      themeColor.content = activeTheme === 'dark' ? '#383934' : '#f6f3eb';
    }
  };

  themeButton?.addEventListener('click', () => {
    const nextTheme = getActiveTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem('site-theme', nextTheme);
    updateThemeControl();
  });

  darkMode.addEventListener('change', () => {
    if (!document.documentElement.dataset.theme) updateThemeControl();
  });

  updateThemeControl();
</script>
