---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  DEFAULT_HIGHLIGHT_ANIMATION,
  HIGHLIGHT_ANIMATION_STORAGE_KEY,
  HIGHLIGHT_ANIMATIONS,
  HIGHLIGHT_TONES,
} from '../scripts/highlightAnimations';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonicalURL = !noindex && Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f3eb" />
    <script
      is:inline
      define:vars={{
        defaultHighlightAnimation: DEFAULT_HIGHLIGHT_ANIMATION,
        highlightAnimationStorageKey: HIGHLIGHT_ANIMATION_STORAGE_KEY,
        highlightAnimations: HIGHLIGHT_ANIMATIONS,
        highlightTones: HIGHLIGHT_TONES,
      }}
    >
      (() => {
        const toneStorageKey = 'site-highlight-tone';
        const skipIntroStorageKey = 'site-highlight-skip-next-intro';
        const root = document.documentElement;
        const savedTone = sessionStorage.getItem(toneStorageKey);
        const finalTone = highlightTones.includes(savedTone)
          ? savedTone
          : highlightTones[Math.floor(Math.random() * highlightTones.length)];
        const requestedAnimation =
          new URLSearchParams(window.location.search).get('animation');
        const savedAnimation = localStorage.getItem(
          highlightAnimationStorageKey,
        );
        const animation = highlightAnimations.includes(requestedAnimation)
          ? requestedAnimation
          : highlightAnimations.includes(savedAnimation)
            ? savedAnimation
            : defaultHighlightAnimation;
        const skipInternalIntro =
          sessionStorage.getItem(skipIntroStorageKey) === 'true';
        sessionStorage.removeItem(skipIntroStorageKey);
        const navigationEntry = performance.getEntriesByType('navigation')[0];
        const navigationType =
          navigationEntry instanceof PerformanceNavigationTiming
            ? navigationEntry.type
            : 'navigate';
        const isReload = navigationType === 'reload';
        const shouldAnimate =
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
          (
            isReload ||
            (!skipInternalIntro && navigationType !== 'back_forward')
          );
        const finalToneIndex = highlightTones.indexOf(finalTone);

        sessionStorage.setItem(toneStorageKey, finalTone);
        root.dataset.highlightAnimation = animation;
        root.dataset.highlightIntro = shouldAnimate ? 'pending' : 'skip';
        root.dataset.highlightTone = shouldAnimate
          ? highlightTones[(finalToneIndex + 1) % highlightTones.length]
          : finalTone;

        const savedTheme = localStorage.getItem('site-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }

        const activeTheme =
          savedTheme ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor instanceof HTMLMetaElement) {
          themeColor.content = activeTheme === 'dark' ? '#383934' : '#f6f3eb';
        }
      })();
    </script>
    <script>
      import { initHighlightAnimations } from '../scripts/highlightAnimations';

      initHighlightAnimations();
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-43238538-1"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'UA-43238538-1');
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={title} href={withBase('/rss.xml')} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
